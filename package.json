{
  "name": "@girish2003-hub/button",
  "version": "0.1.0",
  "description": "A simple React button component for Next.js and React apps",
  "license": "MIT",
  "author": "Girish Khedikar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Girish2003-hub/my-button.git"
  },
  "bugs": {
    "url": "https://github.com/Girish2003-hub/my-button/issues"
  },
  "homepage": "https://github.com/Girish2003-hub/my-button#readme",
  "keywords": [
    "react",
    "nextjs",
    "button",
    "component",
    "ui"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
